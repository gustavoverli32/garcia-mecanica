{
  "name": "garcia-mecanica",
  "private": true,
  "version": "0.1.0",
  "description": "Base de modernização da plataforma Garcia Auto Mecânica",
  "scripts": {
    "validate": "pwsh -NoProfile -File scripts/validate-bundle.ps1",
    "inspect:bundle": "node scripts/inspect-bundle.mjs",
    "extract:template": "node scripts/extract-template.mjs",
    "verify:template": "node scripts/verify-template.mjs",
    "build:original": "node scripts/build-original.mjs",
    "check:original": "node scripts/build-original.mjs --check",
    "check:published": "node scripts/verify-published-bundle.mjs",
    "verify:readonly": "node scripts/assert-readonly.mjs",
    "test": "node --test tests/contracts.test.mjs",
    "verify:env": "node scripts/verify-env-config.mjs",
    "dev": "node scripts/serve-original.mjs",
    "build": "node scripts/build-original.mjs",
    "start": "node scripts/serve-original.mjs",
    "dev:experimental": "next dev",
    "build:experimental": "next build",
    "start:experimental": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "8.5.31",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
